#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../src/Config.php';
require __DIR__ . '/../src/ProjectCreator.php';
require __DIR__ . '/../src/ServiceManager.php';
require __DIR__ . '/../src/AccessManager.php';

use Frampp\ControlPanel\Config;
use Frampp\ControlPanel\ProjectCreator;
use Frampp\ControlPanel\ServiceManager;
use Frampp\ControlPanel\AccessManager;

$argv = $_SERVER['argv'] ?? [];
$args = array_slice($argv, 1);

$jsonMode = in_array('--json', $args, true);
$args = array_values(array_filter($args, static fn (string $a): bool => $a !== '--json'));

$home = null;
$homeIdx = array_search('--home', $args, true);
if ($homeIdx !== false && isset($args[$homeIdx + 1])) {
    $home = $args[$homeIdx + 1];
    array_splice($args, $homeIdx, 2);
}

$cmd = $args[0] ?? 'status';

try {
    $config = Config::discover($home);
    $mgr = new ServiceManager($config);
    $access = new AccessManager($config);

    $data = match ($cmd) {
        'status' => $mgr->status(),
        'start'  => self_start($mgr, $args[1] ?? 'all'),
        'stop'   => self_stop($mgr, $args[1] ?? 'all'),
        'cleanup' => $mgr->cleanupOrphans(),
        'logs'   => $mgr->tailLog($args[1] ?? 'frankenphp', max(1, (int) ($args[2] ?? 50))),
        'ports'  => $mgr->ports(),
        'version' => [
            'frampp' => self_version($config),
            'components' => $config->runtime['components'] ?? [],
        ],
        'new-project' => (new ProjectCreator($config))->create((string) ($args[1] ?? ''), (string) ($args[2] ?? 'minimal')),
        'ip-access' => self_ip_access($access, array_slice($args, 1)),
        default  => throw new \InvalidArgumentException(
            "未知命令: $cmd（支持 status|start|stop|cleanup|logs|ports|version|new-project|ip-access）"
        ),
    };

    if ($jsonMode) {
        echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), PHP_EOL;
    } else {
        renderText($cmd, $data);
    }
} catch (\Throwable $e) {
    fwrite(STDERR, 'ERROR: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}

function self_start(ServiceManager $mgr, string $target): array
{
    $result = [];
    foreach (ServiceManager::services() as $name) {
        if ($target === 'all' || $target === $name) {
            $result[$name] = $mgr->start($name);
        }
    }
    return $result;
}

function self_stop(ServiceManager $mgr, string $target): array
{
    $result = [];
    foreach (array_reverse(ServiceManager::services()) as $name) {
        if ($target === 'all' || $target === $name) {
            $result[$name] = $mgr->stop($name);
        }
    }
    return $result;
}

function renderText(string $cmd, array $data): void
{
    if ($cmd === 'cleanup') {
        $cleaned = $data['cleaned'] ?? [];
        $skipped = $data['skipped'] ?? [];
        printf("cleanup: 已回收 %d 个孤儿进程 / orphan(s) cleaned: %d%s", count($cleaned), count($cleaned), PHP_EOL);
        foreach ($cleaned as $name) {
            echo "  - {$name}", PHP_EOL;
        }
        if ($skipped) {
            printf("过期 PID 文件已清理 / stale pid files removed: %s%s", implode(', ', $skipped), PHP_EOL);
        }
        return;
    }
    if ($cmd === 'ports') {
        foreach ($data as $name => $info) {
            printf("%-10s %-6d %s%s", $name, $info['port'], $info['open'] ? 'OPEN' : 'closed', PHP_EOL);
        }
        return;
    }
    if ($cmd === 'logs') {
        echo $data['file'], PHP_EOL;
        foreach ($data['lines'] as $line) {
            echo $line, PHP_EOL;
        }
        return;
    }
    foreach ($data as $name => $info) {
        if (isset($info['running'])) {
            $mark = ($info['orphan'] ?? false) ? ' ORPHAN' : '';
            printf(
                "%-10s %-8s pid=%-6s port=%s(%s)%s%s",
                $name,
                $info['running'] ? 'RUNNING' : 'STOPPED',
                (string) ($info['pid'] ?? '-'),
                (string) ($info['port'] ?? '-'),
                ($info['port_open'] ?? false) ? 'OPEN' : 'closed',
                $mark,
                PHP_EOL
            );
        } else {
            // start/stop 结果
            printf("%-10s %s%s", $name, json_encode($info, JSON_UNESCAPED_UNICODE), PHP_EOL);
        }
    }
}

function self_version(Config $config): string
{
    $versionFile = $config->root . DIRECTORY_SEPARATOR . 'VERSION';
    if (is_file($versionFile)) {
        $version = trim((string) file_get_contents($versionFile));
        if ($version !== '') {
            return $version;
        }
    }
    return '0.2.0';
}

function self_ip_access(AccessManager $access, array $args): array
{
    $sub = $args[0] ?? 'status';
    switch ($sub) {
        case 'status':
        case 'list':
            return ['config' => $access->config(), 'rules' => $access->rules()];

        case 'add':
            if (count($args) < 3) {
                throw new \InvalidArgumentException('用法: frampp ip-access add <IP|CIDR|code:XX> <allow|block>');
            }
            $access->addRule($args[1], $args[2]);
            break;

        case 'remove':
            if (count($args) < 2) {
                throw new \InvalidArgumentException('用法: frampp ip-access remove <IP|CIDR|code:XX>');
            }
            $access->removeRule($args[1]);
            break;

        case 'default':
            $action = $args[1] ?? '';
            if (!in_array($action, ['allow', 'block'], true)) {
                throw new \InvalidArgumentException('用法: frampp ip-access default <allow|block>');
            }
            $access->saveConfig(['default_action' => $action]);
            break;

        case 'enable':
        case 'disable':
            $access->saveConfig(['enabled' => $sub === 'enable']);
            break;

        case 'geoip':
            if (count($args) < 2) {
                throw new \InvalidArgumentException('用法: frampp ip-access geoip <database> [mmdb|cidr_csv|range_csv]');
            }
            $access->saveConfig(['geoip_db' => $args[1], 'geoip_format' => $args[2] ?? 'mmdb']);
            break;

        case 'reload':
            $ok = $access->reload();
            return ['reloaded' => $ok];

        default:
            throw new \InvalidArgumentException('未知 ip-access 子命令: ' . $sub);
    }

    $access->renderCaddyfile();
    $reloaded = $access->reload();
    return ['config' => $access->config(), 'rules' => $access->rules(), 'caddyfile_rendered' => true, 'reloaded' => $reloaded];
}
