#!/usr/bin/env sh
#
# FRAMPP Composer：使用内置 PHP 运行随包安装的 composer.phar。
#
set -e

FRAMPP_HOME=$(cd "$(dirname "$0")/.." && pwd)
export PHPRC="$FRAMPP_HOME/etc/php.ini"
exec "$FRAMPP_HOME/modules/frankenphp/frankenphp" php-cli -d memory_limit=1G \
    "$FRAMPP_HOME/modules/composer/composer.phar" "$@"
