#!/usr/bin/env sh
#
# FRAMPP 环境：将 bin/ 与常用模块目录加入 PATH，并设置 FRAMPP_HOME / PHPRC。
# 用法（bash/zsh）: . "$FRAMPP_HOME/bin/env"
#
if [ -n "${BASH_SOURCE:-}" ]; then
    _FRAMPP_ENV_SRC="${BASH_SOURCE[0]}"
else
    _FRAMPP_ENV_SRC="$0"
fi

FRAMPP_HOME=$(cd "$(dirname "$_FRAMPP_ENV_SRC")/.." && pwd)
export FRAMPP_HOME
export PATH="$FRAMPP_HOME/bin:$FRAMPP_HOME/modules/python/bin:$FRAMPP_HOME/modules/mariadb/bin:$FRAMPP_HOME/modules/redis:$PATH"
export PHPRC="$FRAMPP_HOME/etc/php.ini"

unset _FRAMPP_ENV_SRC
