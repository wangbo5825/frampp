#!/usr/bin/env sh
#
# FRAMPP Agent / MCP 服务器入口。
#
set -e

FRAMPP_HOME=$(cd "$(dirname "$0")/.." && pwd)
export PHPRC="$FRAMPP_HOME/etc/php.ini"
PHP_BIN="$FRAMPP_HOME/modules/frankenphp/php"
if [ -x "$PHP_BIN" ]; then
    exec "$PHP_BIN" "$FRAMPP_HOME/modules/agent/bin/frampp-mcp" "$@"
fi

# 0.8.2 兼容回退
exec "$FRAMPP_HOME/modules/frankenphp/frankenphp" php-cli \
    "$FRAMPP_HOME/modules/agent/bin/frampp-mcp" "$@"
