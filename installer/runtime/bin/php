#!/usr/bin/env sh
#
# FRAMPP PHP CLI：优先使用 FrankenPHP 1.13.2+ 随包构建的独立 CLI。
#
set -e

FRAMPP_HOME=$(cd "$(dirname "$0")/.." && pwd)
export PHPRC="$FRAMPP_HOME/etc/php.ini"
PHP_BIN="$FRAMPP_HOME/modules/frankenphp/php"
if [ -x "$PHP_BIN" ]; then
    exec "$PHP_BIN" "$@"
fi

# 0.8.2 兼容回退
exec "$FRAMPP_HOME/modules/frankenphp/frankenphp" php-cli "$@"
