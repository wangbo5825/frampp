#!/usr/bin/env bash
#
# FRAMPP Linux 卸载：停止服务、移除 systemd 服务，可选删除数据与日志。
#
set -euo pipefail

FRAMPP_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -x "$FRAMPP_HOME/bin/frampp" ]]; then
    echo "stopping services / 正在停止服务 ..."
    "$FRAMPP_HOME/bin/frampp" stop all || true
fi
if [[ -x "$FRAMPP_HOME/bin/install-systemd" ]]; then
    "$FRAMPP_HOME/bin/install-systemd" --remove || true
fi
echo "services stopped / 服务已停止."

read -r -p "Delete data & logs (var/, logs/; irreversible)? / 是否删除数据与日志（var/、logs/，不可恢复）？ [y/N] " ans
case "$ans" in
    y|Y|yes|YES)
        rm -rf "$FRAMPP_HOME/var" "$FRAMPP_HOME/logs"
        echo "deleted var/ and logs/ / 已删除 var/ 与 logs/."
        ;;
    *)
        echo "kept var/ and logs/ / 已保留 var/ 与 logs/."
        ;;
esac

echo "to fully remove, delete: $FRAMPP_HOME / 如需完全移除，请删除目录"
