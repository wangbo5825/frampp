# FRAMPP 全局配置与托管站点（v0.8.0）
#
# 说明：本文件渲染后写入 etc/global.caddy；主 Caddyfile（etc/Caddyfile）由
# init / AccessManager / caddy-panel 组装 = 本内容 + import etc/caddy.d/*.caddy。
# 8081 管理入口包含平台控制台（服务 / IP 访问控制）与 Caddy 管理界面
# caddy-panel（子路由 /panel；caddy-panel 负责站点 / Caddyfile / 证书 / 日志）。
{
	frankenphp
	admin {{ADMIN_ADDR}}
	auto_https off
	# Souin HTTP 缓存（FrankenPHP 定制构建已内置该模块）。
	# 生产站点可取消注释启用；开发模式建议保持注释，避免缓存干扰调试。
	# order cache before rewrite
	# cache {
	# 	ttl 300s
	# 	default_cache_control public,max-age=300
	# 	redis {
	# 		url redis://127.0.0.1:6379
	# 	}
	# }
}

http://127.0.0.1:8080 {
	root * {{HTDOCS}}
	encode zstd gzip
	route {
		{{ACCESS_IMPORT}}
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	log {
		output file {{LOGS_DIR}}/frankenphp-access.log
	}
}

http://127.0.0.1:8081 {
	encode zstd gzip
	# Caddy 管理界面（caddy-panel）：子路由 /panel，去掉前缀后交给模块 webroot
	handle_path /panel/* {
		root * {{CADDY_PANEL_ROOT}}
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	# 平台控制台：服务 / IP 访问控制 / 站点管理
	handle {
		root * {{PANEL_ROOT}}
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	log {
		output file {{LOGS_DIR}}/panel-access.log
	}
}
