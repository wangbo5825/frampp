# FRAMPP Caddyfile（由 init.sh / init.ps1 生成）
{
	frankenphp
	auto_https off
	# Souin HTTP 缓存（FrankenPHP 定制构建已内置该模块）。
	# 生产站点可取消注释启用；开发模式建议保持注释，避免缓存干扰调试。
	# order cache before rewrite
	# cache {
	# 	ttl 300s
	# 	default_cache_control public,max-age=300
	# 	redis {
	# 		url redis://127.0.0.1:6379
	# 	}
	# }
}

http://127.0.0.1:8080 {
	root * {{HTDOCS}}
	encode zstd gzip
	route {
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	log {
		output file {{LOGS_DIR}}/frankenphp-access.log
	}
}

http://127.0.0.1:8081 {
	root * {{PANEL_ROOT}}
	encode zstd gzip
	route {
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	log {
		output file {{LOGS_DIR}}/panel-access.log
	}
}
