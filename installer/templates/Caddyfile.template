# FRAMPP 全局配置与托管站点（v0.8.0）
#
# 说明：本文件渲染后写入 etc/global.caddy；主 Caddyfile（etc/Caddyfile）由
# init / AccessManager / caddy-panel 组装 = 本内容 + import etc/caddy.d/*.caddy。
# 8081 管理入口包含平台控制台（服务 / IP 访问控制）与 Caddy 管理界面
# caddy-panel（子路由 /panel；caddy-panel 负责站点 / Caddyfile / 证书 / 日志）。
{
	frankenphp
	admin {{ADMIN_ADDR}}
	auto_https off
	# pogo_scheduler（v0.8.2，Linux 定制构建）：由 etc/scheduler.caddy 启用/关闭
	{{SCHEDULER_IMPORT}}
	# Souin HTTP 缓存（FrankenPHP 定制构建已内置该模块）。
	# 生产站点可取消注释启用；开发模式建议保持注释，避免缓存干扰调试。
	# order cache before rewrite
	# cache {
	# 	ttl 300s
	# 	default_cache_control public,max-age=300
	# 	redis {
	# 		url redis://127.0.0.1:6379
	# 	}
	# }
}

(frampp_fingerprint_privacy) {
	# Remove server/technology signatures from normal and error responses.
	header {
		-Server
		-X-Powered-By
		-X-Powered-By-PHP
		-Via
		defer
	}
	handle_errors {
		header {
			-Server
			-X-Powered-By
			-X-Powered-By-PHP
			-Via
		}
		@not_found expression {http.error.status_code} == 404
		handle @not_found {
			respond "Not Found" 404
		}
		@server_error expression {http.error.status_code} >= 500
		handle @server_error {
			respond "Internal Server Error" {http.error.status_code}
		}
		respond "Request Error" {http.error.status_code}
	}
}

http://127.0.0.1:8080 {
	import frampp_fingerprint_privacy
	root * {{HTDOCS}}
	encode zstd gzip
	route {
		{{ACCESS_IMPORT}}
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	log {
		output file {{LOGS_DIR}}/frankenphp-access.log
	}
}

http://127.0.0.1:8081 {
	import frampp_fingerprint_privacy
	encode zstd gzip
	# Caddy 管理界面（caddy-panel）：子路由 /panel，去掉前缀后交给模块 webroot
	handle_path /panel/* {
		root * {{CADDY_PANEL_ROOT}}
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	# 平台控制台：服务 / IP 访问控制 / 站点管理
	handle {
		root * {{PANEL_ROOT}}
		try_files {path} {path}/index.php index.php
		php
		file_server
	}
	log {
		output file {{LOGS_DIR}}/panel-access.log
	}
}
