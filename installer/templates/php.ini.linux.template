[PHP]
; Linux 静态构建：扩展（apcu/redis/mysqli/pdo_mysql/...）已内置，无需 extension= 指令
apc.enable_cli = 1
apc.shm_size = 128M
date.timezone = Asia/Shanghai
memory_limit = 256M
upload_max_filesize = 64M
post_max_size = 64M
max_execution_time = 120
expose_php = Off
; unix socket 模式（frampp mode sock）下由 init / 切换脚本填入实际路径
mysqli.default_socket = {{MYSQL_SOCKET}}
pdo_mysql.default_socket = {{MYSQL_SOCKET}}
