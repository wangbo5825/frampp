[PHP]
extension_dir = "ext"
; M1 必需扩展（与 FrankenPHP Windows 内置 ext/ 目录对应）
extension = curl
extension = fileinfo
extension = intl
extension = mbstring
extension = mysqli
extension = openssl
extension = pdo_mysql
extension = sockets
extension = zip
extension = apcu
apc.enable_cli = 1
apc.shm_size = 128M
date.timezone = Asia/Shanghai
memory_limit = 256M
upload_max_filesize = 64M
post_max_size = 64M
max_execution_time = 120
expose_php = Off
