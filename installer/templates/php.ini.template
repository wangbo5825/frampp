[PHP]
extension_dir = "ext"
; M1 必需扩展（与 FrankenPHP Windows 内置 ext/ 目录对应）
extension = curl
extension = fileinfo
extension = intl
extension = mbstring
extension = mysqli
extension = openssl
extension = pdo_mysql
extension = sockets
extension = zip
extension = apcu
apc.enable_cli = 1
apc.shm_size = 128M
date.timezone = Asia/Shanghai
memory_limit = 256M
upload_max_filesize = 64M
post_max_size = 64M
max_execution_time = 120
expose_php = Off
display_errors = Off
display_startup_errors = Off
html_errors = Off
log_errors = On
zend.exception_ignore_args = On
user_agent = "Mozilla/5.0 (compatible; Application)"
session.use_strict_mode = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.cookie_samesite = Lax
